POR_PROXY_HOST=127.0.0.1
POR_PROXY_PORT=8794
POR_POINTS_DB=/opt/product-operation-report/points.sqlite3
POR_LICENSE_DB=/opt/original-video-dedup-tool/server/license_server.sqlite3
POR_LICENSE_STATUS_URL=http://127.0.0.1:8791/api/license/device/status
POR_LICENSE_ACTIVATE_URL=http://127.0.0.1:8791/api/license/activate
POR_LICENSE_CONSUME_URL=http://127.0.0.1:8791/api/license/credits/consume
POR_PROVIDER_BASE_URL=https://ccg-cli.online/v1
POR_PROVIDER_API_KEY=
POR_PROVIDER_KEYS_FILE=/etc/product-operation-report/provider-keys.json
# 旧环境变量密钥只作为迁移兜底；正式使用 provider-keys.json 热切换，不向客户端下发密钥。
# 可选：为任一备用模型配置独立供应商和独立密钥；未配置时使用上面默认线路。
# POR_PROVIDER_GPT55_BASE_URL=https://provider-a.example/v1
# POR_PROVIDER_GPT55_API_KEY=SET_ON_SERVER_ONLY
# POR_PROVIDER_GPT56_SOL_BASE_URL=https://ccg-cli.online/v1
# POR_PROVIDER_GPT56_SOL_API_KEY=SET_ON_SERVER_ONLY
# POR_PROVIDER_CLAUDE_SONNET_46_BASE_URL=https://provider-b.example/v1
# POR_PROVIDER_CLAUDE_SONNET_46_API_KEY=SET_ON_SERVER_ONLY
# POR_PROVIDER_GEMINI_3_FLASH_BASE_URL=https://provider-c.example/v1
# POR_PROVIDER_GEMINI_3_FLASH_API_KEY=SET_ON_SERVER_ONLY
# POR_PROVIDER_KIMI_K26_BASE_URL=https://provider-d.example/v1
# POR_PROVIDER_KIMI_K26_API_KEY=SET_ON_SERVER_ONLY
POR_SESSION_TTL_SECONDS=900
POR_DAILY_COST_LIMIT_CNY=100
POR_USD_CNY_RATE=7.2
POR_POINTS_PER_CNY=100
POR_COST_RATE=0.5
POR_MAX_OUTPUT_TOKENS=12000
