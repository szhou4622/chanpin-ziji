{
  "name": "product-operation-report-app",
  "version": "1.1.1",
  "description": "产品与内容经营报告系统 — 专业的产品经营与内容分析报告系统",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "lint": "node node_modules/eslint/bin/eslint.js \"src/**/*.{ts,tsx}\"",
    "test:unit": "node node_modules/vitest/vitest.mjs run",
    "test:architecture": "node node_modules/vitest/vitest.mjs run src/shared/architectureGuard.test.ts",
    "test:regression": "node scripts/run-regression.cjs",
    "test:update-release": "node scripts/run-update-release-smoke.cjs",
    "test:html-visual": "node scripts/run-html-visual-smoke.cjs",
    "test:utility": "npm run build && node scripts/run-utility-smoke.cjs",
    "test:packaged-utility": "node scripts/run-packaged-utility-smoke.cjs",
    "test:managed-model": "node scripts/run-managed-model-smoke.cjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "config:managed:import": "electron scripts/import-managed-model-config.cjs",
    "config:managed:set-key": "electron scripts/set-managed-model-key.cjs",
    "update:prepare": "node scripts/prepare-update-release.cjs",
    "update:publish": "powershell -ExecutionPolicy Bypass -File scripts/publish-update-release.ps1",
    "preview": "electron-vite preview",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json && node node_modules/typescript/bin/tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:mac:arm64": "electron-vite build && electron-builder --mac --arm64",
    "dist:mac:x64": "electron-vite build && electron-builder --mac --x64",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "docx": "^9.7.1",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "marked": "^18.0.5",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "^4.7.76",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.1.0",
    "sharp": "^0.35.3",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "^22.20.1",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "9.39.2",
    "rcedit": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "^7.3.6",
    "vitest": "4.1.11",
    "zustand": "^4.5.4"
  }
}
